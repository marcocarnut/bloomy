[Unit]
Description=reseed39 bloom query server (WebSocket + static, plaintext behind stunnel)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/reseed39
# Bind localhost only: all real traffic arrives from stunnel on 127.0.0.1.
Environment=BIND=127.0.0.1
ExecStart=/home/ubuntu/reseed39/server /home/ubuntu/reseed39/alladdrs_classic.blf 8080 /home/ubuntu/reseed39/www
Restart=always
RestartSec=2

# Hardening: the server only reads (filter is mmap'd PROT_READ, static files read-only)
# and writes nothing but its log to journald. None of this blocks reading ~/reseed39.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
